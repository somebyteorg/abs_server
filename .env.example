# 文件输出 通过 X-Accel-Redirect 交给 Caddy 发送音频和封面 留空则为 302 跳转
USE_X_ACCEL=/

# 数据库类型 postgres 默认为 SQLite
DB_DIALECT=postgres

# postgres 数据库连接地址 格式为 postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=

# EMOS 接口地址
EMOS_URL=https://emos.best

# EMOS LINK 地址
EMOS_URL_LINK=https://emos.best/api/sign?state=emos_abs_server
